<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WoWTinkerBox.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#E0B84C" RegionColor="#202020" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
</Application>
